-- allium: 3

-- Module: observability.
-- Scope: the catalogue of metrics, Events and log lines knarr emits and what
-- its own probes report (§8 health_metrics, §9.14). The points at which they
-- are emitted stay in the owning modules: when a pod's contract is absent is
-- reconcile's Absent (ticket 21), when a patch is rejected and when another
-- writer is recognised are ownership's (ticket 22), when a cleanup is made is
-- lifecycle's (ticket 23), and the schedule, the pending set and the pauses
-- are budget's (ticket 24). This module names what each emits, the
-- conventions every name follows and the cadence of the Events and lines
-- raised on entry to a state. The probe responses are knarr's Diagnostics;
-- the Event create is k8s_client's.
-- Owner: ticket 30 settled every question here with the maintainer on
-- 2026-10-12. The reconcile core (ticket 31) emits the readings, cost,
-- standing, pod-state and discovery signals, the readiness latch and the log
-- format; the ownership and lifecycle invariants (ticket 32) the rejection
-- and yield signals and their Events; the poll schedule and patcher (ticket
-- 46) the budget signals, every patch and LIST result and the poll duration,
-- where the patches, LISTs and polls are sent; the client (ticket 41) the
-- Event create. Tickets 19 and
-- 25 add their own rows under the conventions here when they settle
-- (LaterRows); 21 added knarr_pods_unknown on 2026-10-13 (Standing); 23
-- added no row on 2026-10-13 (LaterRows), naming the source of the
-- deployment label on a cleanup (Labels) and when a Deployment's cleanup is
-- done (SeriesLife); 31 added the InvalidOverride Event and the lines it
-- emits the same day (Events InvalidOverride, Logs Lines); and 32 added
-- the rejection and foreign lines on 2026-10-14 (Logs Lines).
-- Ticket 46 built the schedule and the patcher on 2026-10-14, emitting the
-- Budget and Polls rows and every patch and LIST result (Catalogue), added
-- their lines (Logs Lines), and announces a state a reading enters at that
-- reading (Cadence OnEntry).

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- One label of a series: its name and the value it carries.
value Label {
    name: String
    value: String
}

-- One exported series: the metric's name and its labels.
value Series {
    name: String
    labels: List<Label>
}

-- One pair of a pod's metadata.annotations map, as ownership names it.
value Annotation {
    key: String
    value: String
}

-- The content of the Event raised when a pod enters the contract-absent
-- state, on its Deployment: the Deployment by name and uid, the pod, the
-- port and path it was polled at, and the kind of its last reading.
value AbsentEvent {
    deployment_name: String
    deployment_uid: String
    pod_name: String
    port: Integer
    path: String
    reading: ReadingKind
}

-- The content of the Event raised on the first rejection of a run, on the
-- Pod: the pod by name and uid, what the rejected patch was for, the status
-- it was rejected with (422 for a 422 the next LIST classifies as a
-- rejection), the full keys of the owned annotations it concerned in the
-- order the patch names them, and, for a cleanup, the owned annotations that
-- stay on the pod with the values found in the view the patch was built
-- from, or, for a cleanup that released records alone and would have
-- removed only the marker (lifecycle Cleanup Scope, ownership Released),
-- the marker annotation with its raw string; empty for one that released
-- records alone and would have rewritten the marker, keeping other
-- records, and for any other purpose.
value RejectedEvent {
    pod_name: String
    pod_uid: String
    purpose: Purpose
    status: Integer
    keys: List<String>
    left: List<Annotation>
}

-- One pod's place in a state that is announced on entry: the pod, the owned
-- annotation's short name for foreign (null for every other state), and the
-- state.
value Entry {
    pod_name: String
    annotation: String?
    state: foreign | not_ready_with_cost | contract_absent | rejected | cleanup_rejected
}

-- One field of a log line: its name and the JSON text of its value, a quoted
-- and escaped string, an integer, a boolean or an array of strings.
value Field {
    name: String
    value: String
}

-- One log line before it is rendered.
value LogLine {
    time: Timestamp
    level: Level
    msg: String
    fields: List<Field>
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- worker_contract's Reading kinds, verbatim.
enum ReadingKind { valid | not_found | invalid | refused | timed_out | unreachable }

-- What a patch was for: a write cost_mapping or safe_to_evict maps, the
-- removal that spells 0 and reconcile's neutral removal included (reconcile
-- Neutral); ownership's yield; or a removal made because the pod or the
-- annotation leaves knarr's management, which is lifecycle's Cleanup Scope
-- (ticket 23) and ownership's cleanup builds (ownership Released).
enum Purpose { apply | yield | cleanup }

-- Log levels, least to most severe.
enum Level { debug | info | warning | error }

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract Catalogue {
    tier: (value: Integer, thresholds: List<Integer>) -> String
    patch_result: (status: Integer?) -> String
    list_result: (status: Integer?) -> String
    retire: (series: List<Series>, deployment: String) -> List<Series>

    @invariant Naming
        -- Every metric knarr defines is named knarr_<subject>_<unit>: a
        -- counter ends _total, a duration is in seconds and ends _seconds, a
        -- timestamp is unix seconds and ends _timestamp_seconds, and a
        -- boolean is a gauge of 0 or 1. knarr_startups_total keeps its name
        -- and meaning (knarr Diagnostics Metrics); the metrics library's VM
        -- collectors keep their own names. The exposition, its path and its
        -- content type are knarr's Diagnostics.
    @invariant Labels
        -- A per-workload metric carries the label deployment, the
        -- Deployment's name, about 50 values at budget's scale target, which
        -- is a sizing assumption and not a limit knarr enforces, plus labels
        -- whose values are the fixed sets this module names. tier ranges
        -- over drained and 0 to the length of the Deployment's effective
        -- threshold list, whose length config's Keys does not cap (ticket
        -- 19), so its value count, like deployment's, is a sizing
        -- assumption and not a limit knarr enforces; every other label set
        -- is fixed here. For a patch, a rejection or a pending entry
        -- concerning a pod that is not a target, which only a cleanup is,
        -- deployment is the name the pod's ReplicaSet's controller owner
        -- reference carries (k8s_client Owner.name), and is empty when the
        -- chain names no Deployment (lifecycle Cleanup Label, ticket 23).
        -- No metric carries a pod label or a
        -- namespace label: an install is one namespace (§9.18), and per-pod
        -- detail lives in Events and log lines. A label name that also names
        -- a log field means the same thing in both (Logs Format).
    @invariant Polls
        -- knarr_polls_total{deployment, reading} counts every reading a poll
        -- produces, reading being worker_contract's Reading kind verbatim:
        -- valid, not_found, invalid, refused, timed_out or unreachable. A
        -- response budget's Leaving discards is not counted.
        -- knarr_poll_duration_seconds is a histogram with no labels of the
        -- time from send to outcome, a timed_out outcome observed at the
        -- timeout, under the buckets Buckets names.
        -- knarr_polls_skipped_total{deployment} counts the polls budget's
        -- NoOverlap skips. knarr_poll_queue_depth, a gauge with no labels,
        -- is the number of due polls waiting in budget's concurrency queue,
        -- not yet sent.
    @invariant Tiers
        -- knarr_pods{deployment, tier} is a gauge of the Deployment's pods
        -- by the tier of the pod-deletion-cost value the marker records as
        -- applied, which is what the ReplicaSet controller ranks (ownership
        -- Applied): tier returns "drained" for -1 and otherwise cost_mapping's
        -- tier of the value under the Deployment's own thresholds, in
        -- canonical decimal. A pod knarr has not written, or whose record is
        -- a removal, is tier "0". A pod whose pod-deletion-cost stands
        -- conflict, yielded or foreign is not counted here; knarr_annotations
        -- counts it (Standing).
    @invariant Patches
        -- knarr_patches_total{deployment, purpose, result} counts every patch
        -- sent, when its response arrives, purpose being Purpose's apply,
        -- yield or cleanup and result patch_result's label for the
        -- response's status, null for a transport failure: accepted for a
        -- 2xx, precondition_failed for 422, rejected for 400 or 403,
        -- throttled for 429 and error for every other status and for null.
        -- knarr_patch_rejections_total{deployment, purpose} counts every
        -- rejection when it is known: a 400 or 403 at once, and a 422 when
        -- the next LIST classifies it as one with ownership's rejected
        -- (ownership Rejected). A failed cleanup is a rejection whose purpose
        -- is cleanup.
    @invariant Budget
        -- budget's six signals. The patch rate is knarr_patches_total. A 429
        -- is counted once, as result throttled: on knarr_patches_total for a
        -- patch and on knarr_lists_total{resource, result} for a LIST,
        -- counted once per LIST however many pages it read (k8s_client
        -- Pagination), whose
        -- resource is pods, replicasets or deployments (config Discovery,
        -- ticket 19) and whose result is list_result's
        -- label: succeeded for a 2xx, throttled for 429, error for every
        -- other status and for null; no other metric counts a 429.
        -- knarr_paused{scope} is 1 while budget's pause of that scope lasts
        -- and 0 otherwise, and knarr_pause_seconds{scope} is the length of
        -- the current pause as last set, from the 429 that set it to its
        -- until, 0 when not paused; scope is patch for WriteBudget's
        -- BackOff and list for PauseScope's LIST pause.
        -- knarr_patches_pending{deployment} is the number of budget's
        -- Pending entries for the Deployment's pods, and
        -- knarr_patch_pending_oldest_seconds, with no labels, is the age of
        -- the oldest due_since across the install, 0 when nothing is
        -- pending. The poll queue depth and the skipped polls are Polls'.
    @invariant Standing
        -- knarr_annotations{deployment, annotation, standing} is a gauge of
        -- the owned annotations on the Deployment's pods by ownership's
        -- standing, annotation being Owned.name and standing owned,
        -- conflict, yielded or foreign; unowned is not counted. An
        -- annotation counts on a pod exactly when reconcile, or the View
        -- builder for a pod that is not a target (lifecycle View), asks its
        -- standing under ownership's Adoption: when the Deployment enables
        -- it, and otherwise only while the marker holds a record for it.
        -- On a pod that is not a target only an annotation standing owned
        -- counts, so a yielded or conflict record an opt-out leaves, which
        -- no cleanup removes, counts nowhere and does not keep the
        -- Deployment's series alive (SeriesLife). A value
        -- an opt-out leaves counts until cleanup drops its record, whether
        -- cleanup or reconcile's Neutral removed the value first (lifecycle
        -- Cleanup Scope and Marker), and a
        -- safe-to-evict on a pod whose Deployment never enabled it counts
        -- nowhere. Its foreign series are the gauge ownership's Adoption
        -- requires.
        -- knarr_yields_total{deployment, annotation} counts every yield
        -- patch accepted. knarr_pods_not_ready_with_cost{deployment} is the
        -- gauge worker_contract's ReadinessWarning requires,
        -- knarr_pods_unknown{deployment} the number of the Deployment's pods
        -- whose reading is unknown, the window elapsed and the contract not
        -- absent, and knarr_pods_contract_absent{deployment} the number in
        -- the contract-absent state, the two disjoint, as reconcile's
        -- Window, Absent and Gauges decide them (ticket 21).
    @invariant Install
        -- knarr_last_discovery_timestamp_seconds is the end of the last
        -- discovery cycle in which every LIST of it succeeded (budget
        -- ListCadence),
        -- and knarr_discovery_duration_seconds is a histogram with no labels
        -- of the length of every cycle sent, under the buckets Buckets
        -- names. knarr_events_total{reason, result} counts every Event
        -- create attempt by its reason and by created or failed.
        -- knarr_targets{kind} is the number of opted-in Deployments
        -- (deployments) and of their pods the last LIST shows, terminating
        -- ones included (pods). knarr_build_info{version} is 1, with
        -- version knarr's release version.
    @invariant Buckets
        -- knarr_poll_duration_seconds and knarr_discovery_duration_seconds
        -- share the fixed bucket bounds 0.01, 0.025, 0.05, 0.1, 0.25, 0.5,
        -- 1, 2.5, 5, 10, 30 and 60 seconds and +Inf. They are not derived
        -- from config.
    @invariant SeriesLife
        -- A Deployment's series live while knarr acts on its pods. Once the
        -- Deployment is not in the target set, whether it left it in this
        -- process or was never in it, as after a restart or for the empty
        -- name lifecycle's Label counts under, nothing for its pods is
        -- pending with purpose apply or in flight with purpose apply or
        -- yield, and its cleanup
        -- is done, which is lifecycle's Cleanup done being true for its name
        -- (ticket 23), every series
        -- labelled with it is removed, counters included, so a late
        -- response or an opt-out cleanup is counted before the series go:
        -- retire returns the series it is given less every one whose
        -- deployment label is that name. Until that moment every series
        -- stands, the gauges at their last values, and a Deployment that
        -- returns to the target set before it keeps them all; one that
        -- returns after it starts its counters at 0. One series goes
        -- earlier: knarr_polls_skipped_total for a Deployment goes at the
        -- discovery cycle whose LIST leaves it no scheduled pod, since no
        -- poll of its pods can be skipped after it (budget Leaving);
        -- knarr_patches_pending goes with the rest. A terminating
        -- pod counts only in knarr_targets; the tier, standing and pod-state
        -- gauges exclude it. Every count is in memory: a restart starts the
        -- counters at 0, and the per-Deployment gauges carry no series until
        -- the first discovery cycle in which every LIST of it succeeds
        -- rebuilds
        -- them.
    @invariant LaterRows
        -- These invariants are the conventions every later metric follows.
        -- A ticket that settles a signal of its own (19 or 25, as 21 did)
        -- adds its row here with tend under Naming, Labels and SeriesLife,
        -- without reopening ticket 30. Ticket 23 added none on 2026-10-13:
        -- cleanup is visible on knarr_patches_total and
        -- knarr_patch_rejections_total with purpose cleanup, on
        -- knarr_annotations and through CleanupRejected, and each cleanup
        -- patch logs at debug as every patch does (lifecycle Cleanup
        -- Label).
    @invariant Pure
        -- tier, patch_result, list_result and retire are functions of their
        -- arguments alone. Keeping the counts and serving the exposition are
        -- the adapters' of the tickets that emit them, under supervision.
}

contract Events {
    reason: (event: RejectedEvent) -> String
    rejected_message: (event: RejectedEvent) -> String
    absent_message: (event: AbsentEvent) -> String

    @invariant Conventions
        -- Every Event knarr raises is of type Warning, its reason is
        -- UpperCamelCase with no knarr prefix, and its reporting component
        -- is knarr. Whether it is created through core v1 or events.k8s.io
        -- is the client's (ticket 41). Every create is one attempt, never
        -- retried, and counted on knarr_events_total (Catalogue Install).
    @invariant Yielded
        -- The Event ownership's Event raises for a yield has the reason
        -- AnnotationYielded. Its target, content, message and cadence are
        -- ownership's.
    @invariant InvalidOverride
        -- When a Deployment's override key reads invalid (config
        -- InvalidValue), knarr makes one create attempt of an Event with
        -- the reason InvalidOverride whose involvedObject is the Deployment
        -- by name and uid and whose message is config's message, at the
        -- cadence InvalidValue states: on entry per key, when the key first
        -- reads invalid and again when its invalid value text changes, and
        -- once more for each invalid key after a restart. Its line, under
        -- AlsoLogged, carries deployment, key, value and reason. Ticket 31
        -- added this row on 2026-10-13 under LaterRows, since ticket 30's
        -- table carried no row for ticket 19's Event.
    @invariant ContractAbsent
        -- When a pod enters the contract-absent state (Cadence: state
        -- contract_absent), knarr makes one create attempt of an Event with
        -- the reason ContractAbsent whose involvedObject is the pod's
        -- Deployment by name and uid. absent_message renders "pod <pod>: no
        -- knarr status contract at port <port> path <path>; last reading
        -- <reading>", with ReadingKind's literal for <reading>. When a pod
        -- enters that state is reconcile's Absent, and a restart enters it
        -- again once a new run has lasted the window (reconcile Restart).
    @invariant Rejected
        -- On the first rejection of a run for a pod, knarr makes one create
        -- attempt of an Event on the Pod by name and uid, with reason's
        -- value for it: PatchRejected for purpose apply or yield and
        -- CleanupRejected for cleanup. A pod keeps one run per reason: a run
        -- starts with a rejection of its reason and ends with the next
        -- accepted patch to the pod, which ends both; a rejection raises
        -- nothing more while its own reason's run lasts, so a cleanup
        -- rejected after a PatchRejected still raises CleanupRejected. A
        -- rejection is known as Catalogue's
        -- Patches says, a 400 or 403 at once and a 422 when the next LIST
        -- classifies it. The run is in memory only (Cadence: states rejected
        -- and cleanup_rejected), so a restart raises it once more on the next
        -- rejection. knarr_patch_rejections_total counts every rejection.
        -- For PatchRejected, rejected_message renders "<keys>: the apiserver
        -- rejected knarr's patch with <status>; the previous annotations stay
        -- and knarr tries again no sooner than the patch interval", with
        -- <keys> the full annotation keys joined by ", ".
    @invariant CleanupRejected
        -- For CleanupRejected, rejected_message renders "<keys>: the
        -- apiserver rejected knarr's cleanup with <status>; <pairs> stays on
        -- the pod until removed, for example kubectl annotate pod <pod>
        -- <removals>", with <keys> as Rejected says, <pairs> each annotation
        -- left as <key>=<value> joined by ", " ("stay" for more than one),
        -- and <removals> each left key followed by "-", joined by " ". When
        -- left is empty, as for a cleanup that would have rewritten the
        -- marker keeping other records, it renders instead "<keys>: the
        -- apiserver rejected knarr's cleanup with <status>; the record
        -- stays and knarr tries again no sooner than the patch interval",
        -- naming no command: removing the marker by hand would leave every
        -- value it still records foreign for the pod's life (ownership
        -- Adoption).
    @invariant AlsoLogged
        -- Every Event's cause logs one warning line with the reason as the
        -- reason field and the fields of the Event's content, whether or not
        -- the create succeeds, so a lost Event still leaves a trace; a
        -- create that fails logs a second warning line saying so.
    @invariant Pure
        -- reason and both messages are functions of their arguments alone.
        -- Creating the Event is k8s_client's; deciding the run and the entry
        -- is Cadence's.
}

contract Cadence {
    entered: (seen: List<Entry>, current: List<Entry>) -> List<Entry>

    @invariant OnEntry
        -- A state that is announced on entry is announced once when a pod
        -- (and, for foreign, an owned annotation) enters it in this process,
        -- not while it stays, and again when it re-enters after leaving.
        -- entered returns every entry of current that seen does not hold;
        -- the caller announces those and keeps current as the next seen.
        -- foreign is read from the latest views each discovery cycle;
        -- not_ready_with_cost, from the pod's newest view, and
        -- contract_absent, from reconcile's pod state (reconcile Absent),
        -- are read for a pod each time a reading of it is observed and for
        -- every pod each discovery cycle, so a state a reading enters is
        -- announced then, a state a view change or a restart enters is
        -- announced at the cycle, and a state entered and left between two
        -- cycles is announced once; rejected is held from a rejection with
        -- purpose apply or
        -- yield, and cleanup_rejected from one with purpose cleanup, to the
        -- pod's next accepted patch (Events Rejected). A terminating pod or
        -- one the LIST no longer shows leaves every state, where for
        -- rejected and cleanup_rejected the LIST is the unselected pod
        -- LIST, so a pod of an opted-out Deployment whose cleanup is
        -- rejected stays in cleanup_rejected across cycles and raises one
        -- Event per run (lifecycle Cleanup Retry), and for every other
        -- state it is the target set. The gauges carry
        -- "still in it".
    @invariant Restart
        -- seen is in memory only and empty after a restart, so every state
        -- current holds at the first evaluation is announced once more.
    @invariant Pure
        -- entered is a function of its arguments alone.
}

contract Logs {
    render: (line: LogLine) -> String
    enabled: (level: Level, threshold: Level) -> Boolean

    @invariant Format
        -- knarr logs through OTP logger to stdout, one JSON object per line.
        -- render writes the members time, as RFC 3339 UTC with milliseconds
        -- (2026-10-12T09:30:00.123Z), level, as Level's literal, and msg, in
        -- that order, then each field in the order given, flat, no
        -- whitespace, and a newline. These names are the shared vocabulary
        -- and mean the same on every line: deployment, pod, annotation (one
        -- Owned.name), reading, cost, accepting, standing, purpose, status,
        -- reason, applied, found, retry_after_seconds, pause_seconds and
        -- scope; a name that is also a metric label means the same thing. A
        -- line whose owner needs more uses further flat snake_case names,
        -- among them port and path for a poll, keys for the full annotation
        -- keys of a patch, as an array of strings, and sha256 and
        -- expires_at for a token change. A field appears at most once and
        -- only when it applies.
    @invariant Levels
        -- error: knarr cannot do its job, as when the token or the
        -- namespace is unreadable, a LIST fails or a process crashes.
        -- warning: an operator should act, as for each Event's cause
        -- (AlsoLogged), a foreign annotation, a pod NotReady with cost and a
        -- failed Event create. info: knarr's own life, as startup, a pause
        -- starting and ending, and the token file changing. debug: each poll
        -- and each patch. enabled is true when level is threshold or more
        -- severe, in Level's order; the threshold is config.log_level, info
        -- by default, set by OTP application configuration as knarr's
        -- Listening sets the bind address.
    @invariant StateLines
        -- A line for a pod's state, foreign, NotReady with cost,
        -- contract absent or rejected, is logged on entry as Cadence's
        -- OnEntry says: once on entry in this process, none while the state
        -- stays, again on re-entry, and once for each current state after a
        -- restart.
    @invariant Lines
        -- The lines the reconcile core (ticket 31) and the schedule and
        -- patcher (ticket 46) emit, by msg and level, so an operator and a
        -- proof can grep for them. error: "token
        -- unreadable" and "namespace unreadable", with reason, when a
        -- cycle's file read fails (k8s_client TokenReload); "list failed",
        -- with resource, pods, replicasets or deployments, and either
        -- status, for a refused LIST, or error, the transport failure such
        -- as "tls_alert unknown_ca", when a LIST fails. warning: "unknown
        -- key", with deployment and key, once per discovery cycle for each
        -- key config's unknown returns; "invalid override", "contract
        -- absent" and "annotation yielded", each with reason and the
        -- Event's fields (AlsoLogged); "event create failed", with reason
        -- and status or error; "not ready with cost", with deployment, pod
        -- and applied (StateLines); "poll worker not started", with pod
        -- and reason, when the scheduler cannot start a poll's worker, the
        -- poll staying in the queue to be sent again. info: "started",
        -- once, with version; "token changed", with sha256 and expires_at;
        -- "discovery", once per cycle in which every LIST succeeded, with
        -- deployments and pods, the counts knarr_targets carries; "patch
        -- pause" and "list pause", once per 429 that lengthens the pause of
        -- that scope, with pause_seconds, the length from that 429 to its
        -- until, retry_after_seconds when the 429 carried the header, and
        -- scope, patch or list, where a 429 on a LIST logs "list failed"
        -- first; "patch pause ended" and "list pause ended", once when the
        -- pause of that scope is found over, with scope. debug: "poll",
        -- with deployment, pod, port, path, reading and, for a valid
        -- reading, cost and accepting; "patch", with deployment, pod,
        -- purpose, keys and status or error.
        -- Ticket 32 added on 2026-10-14, each at warning: "patch
        -- rejected", with reason, deployment, pod, purpose, status and
        -- keys, once per rejection run as the PatchRejected Event's cause
        -- (AlsoLogged, Events Rejected); "cleanup rejected", with the same
        -- fields and left, the annotations the Event's left names as an
        -- array of "key=value" strings, empty when it names none, which
        -- is an array of strings as Format allows, once per run as the
        -- CleanupRejected Event's cause (AlsoLogged, Events
        -- CleanupRejected); and "foreign annotation", with deployment,
        -- pod, annotation, the Owned.name, key, the full annotation key,
        -- and value, the value found, on entry (StateLines, Cadence
        -- OnEntry).
    @invariant NeverLogged
        -- No line carries the service-account token or the Authorization
        -- header; k8s_client's TokenReload logs a token change only as the
        -- file's sha256 and the token's expiry claim. No line carries a
        -- worker's response body: a poll logs its reading kind, the status
        -- and, for a valid reading, cost and accepting. No line carries an
        -- apiserver response body or a whole Pod object: only the status
        -- code, the pod's name and the owned values involved. No line
        -- carries a raw URL with its query string: a poll is named by its
        -- pod and path.
    @invariant Pure
        -- render and enabled are functions of their arguments alone; the
        -- time is passed in. Writing the line is OTP logger's.
}

contract Probes {
    @invariant Liveness
        -- /healthz is process-level only: it answers 200 while the listener
        -- serves and the supervision tree is up, and never depends on the
        -- apiserver or a worker, since a restart would refill the bucket
        -- (budget Restart) and fix nothing. A stalled loop is an alert on
        -- knarr_last_discovery_timestamp_seconds, not a liveness failure.
    @invariant Readiness
        -- /readyz answers 503 until the first discovery cycle in which every
        -- LIST of it succeeds, then 200 for the life of the process: the
        -- latch is never released. A configuration that runs no discovery
        -- cycle, one without the discovery setting knarr's NoPodEffects
        -- names, as the gate runs knarr, is ready once the supervision tree
        -- starts. The responses themselves are knarr's Diagnostics Health
        -- and Readiness.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    log_level: Level = info
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Tiers and reconcile NoPodIp: a target pod without a pod IP has no reading and no state, and the tier gauge counts it on no series, while knarr_targets counts it; whether knarr_pods should carry it on tier \"0\", as a pod knarr has not written, or the gauges should exclude it as they exclude a terminating pod."
