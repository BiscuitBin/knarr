-- allium: 3

-- Module: k8s_client.
-- Scope: the in-cluster API boundary (§8, §9.2). Verified TLS with the
-- service-account CA and an IP-SAN hostname check, token reload from disk,
-- the operations the reconciler makes and the Role verbs each implies (list
-- and patch on pods, list on ReplicaSets and Deployments, create on core
-- events), the JSON Patch write mode with the preconditions ownership's
-- WriteMode states, the pagination of a LIST and the failures callers
-- branch on, with the status and Retry-After budget reads.
-- Owner: spike S1 (ticket 14) settled the TLS, token and verb questions in
-- Decision 0013; ticket 22 amended Verbs, NoPatchWhileTerminating and the
-- Pod and patch shapes with what the write mode needs (ownership, §9.10);
-- ticket 41 stated the full contract and built it. Event reasons are
-- observability's (ticket 30); rate limiting is budget's (ticket 24).

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Target {
    host: String
    port: Integer
}

value Annotation {
    key: String
    value: String
}

value Label {
    key: String
    value: String
}

-- The ownerReference whose controller flag is true: the object that
-- manages this one. A pod's is its ReplicaSet, a ReplicaSet's its
-- Deployment.
value Owner {
    kind: String
    name: String
    uid: String
}

-- A pod as the client reads it: its uid, which the conflict Event's
-- involvedObject names; its annotations as the list of the map's pairs, null
-- when the response carries no annotations map, which is also how the
-- apiserver serves an empty one and what ownership's WriteMode branches on;
-- its deletion timestamp; its primary IP from status.podIP, null before one
-- is assigned, which worker_contract's Discovery polls; whether its Ready
-- condition is "True", false when the condition is absent; and its
-- controller owner.
value Pod {
    name: String
    uid: String
    annotations: List<Annotation>?
    deletion_timestamp: Timestamp?
    pod_ip: String?
    ready: Boolean
    owner: Owner?
}

value ReplicaSet {
    name: String
    uid: String
    owner: Owner?
}

-- A Deployment's metadata as the apiserver serves it. Which labels and
-- annotations matter is config's (ticket 19); the client reads them all,
-- and an absent map is an empty list.
value Deployment {
    name: String
    uid: String
    labels: List<Label>
    annotations: List<Annotation>
}

-- The conflict Event ownership's Event raises, on the Pod. The reason is
-- observability's (ticket 30) and is passed in; the message is ownership's
-- message.
value Event {
    pod_name: String
    pod_uid: String
    reason: String
    message: String
    at: Timestamp
}

-- Why a response was refused: its status, its Retry-After, and the kind
-- Failures classifies it as.
value Failure {
    kind: forbidden | not_found | conflict | precondition_failed | throttled | other
    status: Integer
    retry_after: Duration?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract Client {
    list_pods: (target: Target, namespace: String) -> List<Pod>
    list_replica_sets: (target: Target, namespace: String) -> List<ReplicaSet>
    list_deployments: (target: Target, namespace: String) -> List<Deployment>
    patch_pod: (target: Target, namespace: String, pod_name: String, document: String) -> Pod
    create_event: (target: Target, namespace: String, event: Event) -> Boolean
    failure: (status: Integer, retry_after: String?, operation: list | patch | create) -> Failure
    precondition_failed: (failure: Failure) -> Boolean

    @invariant VerifiedTls
        -- Every request to the apiserver verifies the peer (verify_peer)
        -- against the service-account ca.crt alone, with an https hostname
        -- check. An IP-literal host, the form KUBERNETES_SERVICE_HOST takes,
        -- is checked against the certificate's IP subjectAltName. There is no
        -- unverified fallback: a handshake that fails is reported as a value
        -- and the request is not sent.
    @invariant TokenReload
        -- The bearer token and the namespace are read from their projected
        -- files on every cycle, never cached for the life of the process. A
        -- failed read of either is logged and that cycle makes no request.
        -- The token itself is never logged; a change of its file is logged
        -- as the file's sha256 and the token's expiry claim.
    @invariant Verbs
        -- The client makes exactly these requests, in its own namespace:
        -- list on core pods, patch on one core pod, list on apps
        -- replicasets, list on apps deployments, and create on core events.
        -- There is no get, no watch, no delete and no other resource; the
        -- next LIST, not a GET, is how a caller learns what a pod is now
        -- (ownership Precondition). The Role grants exactly these verbs on
        -- these resources. A patch is a JSON Patch, content type
        -- application/json-patch+json, whose body is the document ownership
        -- renders, sent as given; patch_pod returns the patched pod as the
        -- newest view ownership's Adoption reads from.
    @invariant NoPatchWhileTerminating
        -- A pod is not patched when the most recent list shows its
        -- deletion_timestamp set, and every patch tests that
        -- /metadata/deletionTimestamp is still null, so a deletion that
        -- lands between the list and the patch fails the patch with 422
        -- instead of being written over (ownership WriteMode and
        -- Precondition). Amended by ticket 22: the window the list-only
        -- check left open is closed by the test.
    @invariant Failures
        -- A response with any status but the success one, 200 for a list
        -- or a patch and 201 for a create, is a Failure, classified by its
        -- status alone: 403 is forbidden, the Role's refusal; 404 is
        -- not_found; 409 is conflict; 429 is throttled; 422 is
        -- precondition_failed from patch_pod, which ownership's Precondition
        -- and Rejected branch on, and other from every other operation;
        -- every other status is other. failure is that classification, a
        -- function of the status, the raw Retry-After header and the
        -- operation alone, and precondition_failed is true for the
        -- precondition_failed kind only. Every Failure carries its status and its
        -- Retry-After, which budget's BackOff and PauseScope read.
        -- A 404 or 409 from a patch is a Failure of its own kind, never a
        -- precondition failure, and is left to the next LIST. The response
        -- body is kept for the log and never read to classify. A transport
        -- error, which VerifiedTls's failed handshake is one of, and a
        -- success whose body does not decode are values distinct from a
        -- Failure and from each other.
    @invariant RetryAfter
        -- The Retry-After header is read as a number of seconds when its
        -- value is a non-negative decimal integer and nothing else. Any
        -- other form, an HTTP-date among them, and an absent header are
        -- null.
    @invariant Pagination
        -- Every LIST asks for pages of at most 500 items and follows the
        -- continue token each page's metadata carries until a page carries
        -- none or an empty one; the operation returns the pages' items in
        -- the order served. A Failure, a transport error or an undecodable
        -- body on any page fails the whole LIST and discards the pages
        -- already read, so a caller never acts on part of a namespace;
        -- budget's ListCadence retries the cycle.
    @invariant ServiceAddress
        -- The host is KUBERNETES_SERVICE_HOST as given, an IPv4 or IPv6
        -- literal. An IPv6 host is bracketed in the request URL, and
        -- VerifiedTls checks it against the certificate's IPv6
        -- subjectAltName.
    @invariant ConflictEvent
        -- create_event makes one core v1 Event in the pod's namespace: its
        -- name generated from the prefix "<pod_name>.", its involvedObject
        -- the Pod by namespace, name and uid, type Warning, the reason and
        -- message the Event carries, source.component knarr, count 1, and
        -- firstTimestamp and lastTimestamp both at. It returns true on 201.
        -- One call is one create attempt, which ownership's Event relies on:
        -- the client never retries it.
}
