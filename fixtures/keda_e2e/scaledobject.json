{
  "apiVersion": "keda.sh/v1alpha1",
  "kind": "ScaledObject",
  "metadata": {
    "name": "fake-worker",
    "labels": {
      "app.kubernetes.io/part-of": "knarr-fixtures"
    }
  },
  "spec": {
    "scaleTargetRef": {
      "name": "fake-worker"
    },
    "pollingInterval": 5,
    "minReplicaCount": 6,
    "maxReplicaCount": 6,
    "advanced": {
      "horizontalPodAutoscalerConfig": {
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 0,
            "policies": [
              {
                "type": "Percent",
                "value": 100,
                "periodSeconds": 15
              }
            ]
          },
          "scaleUp": {
            "stabilizationWindowSeconds": 0,
            "policies": [
              {
                "type": "Percent",
                "value": 100,
                "periodSeconds": 15
              }
            ]
          }
        }
      }
    },
    "triggers": [
      {
        "type": "cron",
        "metadata": {
          "timezone": "Etc/UTC",
          "start": "0 0 1 1 *",
          "end": "1 0 1 1 *",
          "desiredReplicas": "6"
        }
      }
    ]
  }
}
