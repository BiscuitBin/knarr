{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "fake-worker",
        "labels": {
          "app.kubernetes.io/name": "fake-worker",
          "app.kubernetes.io/part-of": "knarr-fixtures"
        }
      },
      "spec": {
        "replicas": 4,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "fake-worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "fake-worker",
              "app.kubernetes.io/part-of": "knarr-fixtures"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "enableServiceLinks": false,
            "terminationGracePeriodSeconds": 20,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "fake-worker",
                "image": "fake-worker:local",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "status",
                    "containerPort": 8080
                  },
                  {
                    "name": "control",
                    "containerPort": 8081
                  }
                ],
                "env": [
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "FAKE_WORKER_DRAIN_SECONDS",
                    "value": "5"
                  },
                  {
                    "name": "FAKE_WORKER_SINK_URL",
                    "value": "http://fake-worker-collector:8081"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "securityContext": {
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "fake-worker-collector",
        "labels": {
          "app.kubernetes.io/name": "fake-worker-collector",
          "app.kubernetes.io/part-of": "knarr-fixtures"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "fake-worker-collector"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "fake-worker-collector",
              "app.kubernetes.io/part-of": "knarr-fixtures"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "enableServiceLinks": false,
            "terminationGracePeriodSeconds": 10,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "fake-worker-collector",
                "image": "fake-worker:local",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "control",
                    "containerPort": 8081
                  }
                ],
                "env": [
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "FAKE_WORKER_MODE",
                    "value": "collector"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "securityContext": {
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "fake-worker-collector",
        "labels": {
          "app.kubernetes.io/name": "fake-worker-collector",
          "app.kubernetes.io/part-of": "knarr-fixtures"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "fake-worker-collector"
        },
        "ports": [
          {
            "name": "control",
            "port": 8081,
            "targetPort": "control"
          }
        ]
      }
    }
  ]
}
