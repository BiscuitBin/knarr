{
  "alertmanager": {
    "enabled": false
  },
  "prometheus-node-exporter": {
    "enabled": false
  },
  "prometheus-pushgateway": {
    "enabled": false
  },
  "kube-state-metrics": {
    "enabled": true,
    "namespaces": "default",
    "collectors": [
      "deployments",
      "pods",
      "replicasets"
    ],
    "rbac": {
      "useClusterRole": false
    },
    "resources": {
      "requests": {
        "cpu": "10m",
        "memory": "32Mi"
      }
    }
  },
  "configmapReload": {
    "prometheus": {
      "enabled": false
    }
  },
  "scrapeConfigs": null,
  "server": {
    "namespaces": [
      "default"
    ],
    "useExistingClusterRoleName": "knarr-observability-pod-reader",
    "global": {
      "scrape_interval": "15s",
      "evaluation_interval": "15s"
    },
    "retention": "6h",
    "persistentVolume": {
      "enabled": false
    },
    "resources": {
      "requests": {
        "cpu": "50m",
        "memory": "128Mi"
      }
    }
  },
  "serverFiles": {
    "prometheus.yml": {
      "rule_files": [],
      "scrape_configs": [
        {
          "job_name": "knarr",
          "kubernetes_sd_configs": [
            {
              "role": "pod",
              "namespaces": {
                "names": [
                  "default"
                ]
              }
            }
          ],
          "metrics_path": "/metrics",
          "relabel_configs": [
            {
              "source_labels": [
                "__meta_kubernetes_pod_label_app_kubernetes_io_name"
              ],
              "regex": "knarr",
              "action": "keep"
            },
            {
              "source_labels": [
                "__meta_kubernetes_pod_container_port_name"
              ],
              "regex": "http",
              "action": "keep"
            },
            {
              "source_labels": [
                "__meta_kubernetes_namespace"
              ],
              "target_label": "namespace"
            },
            {
              "source_labels": [
                "__meta_kubernetes_pod_name"
              ],
              "target_label": "pod"
            }
          ]
        },
        {
          "job_name": "kube-state-metrics",
          "static_configs": [
            {
              "targets": [
                "prometheus-kube-state-metrics.observability.svc:8080"
              ]
            }
          ]
        }
      ]
    }
  }
}
