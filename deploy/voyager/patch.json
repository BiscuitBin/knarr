{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "knarr"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "knarr",
            "env": [
              {
                "name": "ERL_FLAGS",
                "value": "-knarr discovery true -name knarr@127.0.0.1 -kernel inet_dist_listen_min 9100 -kernel inet_dist_listen_max 9100 -kernel inet_dist_use_interface {127,0,0,1}"
              },
              {
                "name": "ERL_ZFLAGS",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "knarr-voyager",
                    "key": "erl_zflags"
                  }
                }
              },
              {
                "name": "ERL_EPMD_ADDRESS",
                "value": "127.0.0.1"
              },
              {
                "name": "HOME",
                "value": "/tmp"
              }
            ],
            "ports": [
              {
                "name": "epmd",
                "containerPort": 4369
              },
              {
                "name": "dist",
                "containerPort": 9100
              }
            ]
          }
        ]
      }
    }
  }
}
