{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "knarr"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "knarr",
            "env": [
              {
                "name": "ERL_FLAGS",
                "value": "-knarr discovery true -knarr list_interval 10 -knarr poll_interval 5 -knarr poll_timeout 4 -knarr patch_interval 10"
              }
            ]
          }
        ]
      }
    }
  }
}
